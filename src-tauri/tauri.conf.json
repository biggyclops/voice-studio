{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Studio",
  "version": "0.1.0",
  "identifier": "com.biggyclops.voicestudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Voice Studio", "width": 820, "height": 720, "minWidth": 640, "minHeight": 520 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/ffmpeg"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
